{
  "name": "@oneunit/logger",
  "version": "1.1.0",
  "description": "High-performance structured logging with Pino, Fastify integration, and transport utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/logger/config.d.ts",
      "import": "./dist/logger/config.js",
      "default": "./dist/logger/config.js"
    },
    "./http": {
      "types": "./dist/http/middleware.d.ts",
      "import": "./dist/http/middleware.js",
      "default": "./dist/http/middleware.js"
    },
    "./logger": {
      "types": "./dist/logger/logger.d.ts",
      "import": "./dist/logger/logger.js",
      "default": "./dist/logger/logger.js"
    },
    "./serialize": {
      "types": "./dist/http/serializers.d.ts",
      "import": "./dist/http/serializers.js",
      "default": "./dist/http/serializers.js"
    },
    "./transport": {
      "types": "./dist/transport/transport.d.ts",
      "import": "./dist/transport/transport.js",
      "default": "./dist/transport/transport.js"
    },
    "./config-validation": {
      "types": "./dist/config-validation.d.ts",
      "import": "./dist/config-validation.js",
      "default": "./dist/config-validation.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "default": "./dist/presets.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "config": [
        "./dist/logger/config.d.ts"
      ],
      "config-validation": [
        "./dist/config-validation.d.ts"
      ],
      "http": [
        "./dist/http/middleware.d.ts"
      ],
      "logger": [
        "./dist/logger/logger.d.ts"
      ],
      "presets": [
        "./dist/presets.d.ts"
      ],
      "serialize": [
        "./dist/http/serializers.d.ts"
      ],
      "transport": [
        "./dist/transport/transport.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "example": "tsx examples/ts/logger-example.ts",
    "example:http": "tsx examples/ts/http-example.ts",
    "example:fastify": "tsx examples/ts/fastify-example.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run test/logger/security.test.ts",
    "test:integration": "vitest run test/http/integration.test.ts",
    "test:serializers": "vitest run test/http/serializers.test.ts",
    "test:api": "vitest run test/core/api.test.ts",
    "test:perf": "vitest run test/core/performance.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm run typecheck:examples && npm test",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run build && npm run typecheck && npm run typecheck:examples && npm test && npm run pack:check"
  },
  "keywords": [
    "oneunit",
    "node",
    "typescript",
    "logger",
    "logging",
    "pino",
    "structured-logging",
    "fastify",
    "redaction"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneunitjs/logger.git"
  },
  "bugs": {
    "url": "https://github.com/oneunitjs/logger/issues"
  },
  "homepage": "https://github.com/oneunitjs/logger#readme",
  "dependencies": {
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-std-serializers": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "express": "^5.3.0",
    "fastify": "^5.12.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "pino-pretty": "^13.1.3"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  }
}
